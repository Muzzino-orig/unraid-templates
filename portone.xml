<?xml version="1.0"?>
<Container version="2">
  <Name>portone</Name>
  <Repository>ghcr.io/muzzino-orig/portone:latest</Repository>
  <Registry>https://ghcr.io/muzzino-orig/portone</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/muzzino-orig/portone/issues</Support>
  <Project>https://github.com/muzzino-orig/portone</Project>
  <Overview>Portone Smart Opener - Production-ready secure door controller microservice with PWA, Home Assistant webhook integration, and PostgreSQL persistence.</Overview>
  <Category>HomeAutomation: Security: Status:Stable</Category>
  <WebUI>http://[IP]:[PORT:3000]</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/lucide-icons/lucide/main/icons/door-closed.svg</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Description>Portone Smart Opener - Production-ready secure door controller microservice with PWA, Home Assistant webhook integration, and PostgreSQL persistence.</Description>
  <Networking>
    <Mode>bridge</Mode>
    <Publish>
      <Port>
        <HostPort>3005</HostPort>
        <ContainerPort>3000</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
    </Publish>
  </Networking>
  <Data>
    <Volume>
      <HostDir>/mnt/user/appdata/portone</HostDir>
      <ContainerDir>/app/data</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
  </Data>
  <Environment>
    <Variable>
      <Value>super_secret_auth_token_for_sessions_and_crypto</Value>
      <Name>AUTH_SECRET</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>postgresql://user:pass@192.168.1.100:5432/</Value>
      <Name>DATABASE_URL</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>portone</Value>
      <Name>PROJECT_DB_NAME</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>admin@portone.local</Value>
      <Name>INIT_ADMIN_EMAIL</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>password123</Value>
      <Name>INIT_ADMIN_PASSWORD</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>http://192.168.1.100:8123/api/webhook/apri_portone_secret_token</Value>
      <Name>HA_WEBHOOK_URL</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>3000</Value>
      <Name>PORT</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>false</Value>
      <Name>COOKIE_SECURE</Name>
      <Mode/>
    </Variable>
  </Environment>
  <Labels/>
  <!-- Configuration UI Tags for Unraid Community Apps & DockerMan -->
  <Config Name="Web Port" Target="3000" Default="3005" Mode="tcp" Description="Host web port mapped to container port 3000" Type="Port" Display="always" Required="true" Mask="false">3005</Config>
  <Config Name="AUTH_SECRET" Target="AUTH_SECRET" Default="" Mode="" Description="Cryptographic secret token for session signing and API authorization" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="DATABASE_URL" Target="DATABASE_URL" Default="postgresql://user:pass@192.168.1.100:5432/" Mode="" Description="PostgreSQL host connection URL without database name" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="PROJECT_DB_NAME" Target="PROJECT_DB_NAME" Default="portone" Mode="" Description="Target project database name" Type="Variable" Display="always" Required="true" Mask="false">portone</Config>
  <Config Name="INIT_ADMIN_EMAIL" Target="INIT_ADMIN_EMAIL" Default="admin@portone.local" Mode="" Description="Initial Administrator email for Zero-Touch Provisioning" Type="Variable" Display="always" Required="true" Mask="false">admin@portone.local</Config>
  <Config Name="INIT_ADMIN_PASSWORD" Target="INIT_ADMIN_PASSWORD" Default="" Mode="" Description="Initial Administrator password" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="HA_WEBHOOK_URL" Target="HA_WEBHOOK_URL" Default="" Mode="" Description="Home Assistant webhook URL triggered to release the door latch" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="PORT" Target="PORT" Default="3000" Mode="" Description="Internal container listening port" Type="Variable" Display="advanced" Required="false" Mask="false">3000</Config>
  <Config Name="COOKIE_SECURE" Target="COOKIE_SECURE" Default="false" Mode="" Description="Enforce HTTPS-only secure cookies (true for HTTPS reverse proxy, false for LAN HTTP)" Type="Variable" Display="always" Required="false" Mask="false">false</Config>
</Container>
